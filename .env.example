# Vault Postgres (docker compose up -d; password quoted if it contains # $ or spaces)
VAULT_POSTGRES_USER=vault
VAULT_POSTGRES_PASSWORD=vault
VAULT_POSTGRES_HOST=localhost
VAULT_POSTGRES_PORT=5435
VAULT_POSTGRES_DB=vault
VAULT_POSTGRES_SCHEMA=vault

# Optional full URL override (else built from VAULT_POSTGRES_* above).
# Remove or comment out if set — it takes precedence and will break local docker compose.
# VAULT_DATABASE_URL=postgresql://user:pass@localhost:5433/monday?schema=vault

# AES-256 key (base64, 32 bytes)
VAULT_ENCRYPTION_KEY=

# vault-api
VAULT_SERVICE_TOKEN=dev-token
PORT=4010

# Object storage — Hetzner (production) or MinIO (local docker compose)
VAULT_STORAGE_ENDPOINT=http://localhost:9000
VAULT_STORAGE_REGION=us-east-1
VAULT_STORAGE_ACCESS_KEY=minio
VAULT_STORAGE_SECRET_KEY=minio123
# Required for Hetzner; default true (path-style). Set false only for AWS virtual-hosted buckets.
# VAULT_STORAGE_FORCE_PATH_STYLE=true
