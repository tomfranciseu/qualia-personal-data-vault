# Dedicated vault Postgres (can match monday dev DB with vault schema)
VAULT_DATABASE_URL=postgresql://user:pass@localhost:5433/monday?schema=vault

# AES-256 key (base64, 32 bytes)
VAULT_ENCRYPTION_KEY=

# vault-api
VAULT_SERVICE_TOKEN=dev-token
PORT=4010

# GCS (document storage)
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
