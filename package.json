{
  "name": "qualia-personal-data-vault",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GDPR-oriented personal data vault — packages, vault-api service, and vault schema",
  "packageManager": "npm@11.14.1",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "check:types": "tsc --noEmit",
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "dev:vault-api": "npm run dev -w @qualia/vault-api",
    "postinstall": "prisma generate"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.17",
    "prisma": "^7.10.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "vite": "^8.3.5",
    "@google-cloud/storage": "^8.4.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
